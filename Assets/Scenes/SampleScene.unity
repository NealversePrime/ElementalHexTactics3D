MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1840787224}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5f7201a12d95ffc409449d95f23cf332, type: 3}
  m_Name: 
  m_EditorClassIdentifier: UnityEngine.UI::UnityEngine.UI.Text
  m_Material: {fileID: 0}
  m_Color: {r: 0.85, g: 0.88, b: 0.94, a: 1}
  m_RaycastTarget: 0
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_FontData:
    m_Font: {fileID: 12800000, guid: 6cfa11f87ef2bd24cb8ffeef0c1fe9ec, type: 3}
    m_FontSize: 15
    m_FontStyle: 0
    m_BestFit: 0
    m_MinSize: 10
    m_MaxSize: 40
    m_Alignment: 0
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 1
    m_VerticalOverflow: 1
    m_LineSpacing: 1
  m_Text: "<b><color=#38BDF8>1. Camera Controls:</color></b> <b>Q / E</b> Rotate 60\xB0 | <b>WASD</b> Pan Diorama | <b>Scroll</b> Zoom in/out\n<b><color=#38BDF8>2. Tactical Orders:</color></b> <b>Left-Click</b> to Select Unit / Cast Spell | <b>Right-Click</b> to Cancel\n\n<b><color=#FBBF24>3. Dynamic Terraforming (Divinity Style):</color></b>\n\u2022 \U0001F525 <b>Fireball:</b> Scorches grass into molten <b>Magma</b> (damages enemies, gives Fire Titan +2 ATK!).\n\u2022 \U0001F4A7 <b>Water Blast:</b> Extinguishes lava into <b>Steam Smokescreens</b>; forms water pools.\n\u2022 \U0001FAA8 <b>Earth Spire:</b> Raises high <b>Stone Pillars</b> (creates physical barriers & collision surfaces).\n\n<b><color=#EF5350>4. Kinetic Push & Wall Slams (Into the Breach):</color></b>\n\u2022 \U0001F4A5 <b>Kinetic Shove:</b> Push enemies 1 hex away. Slamming an enemy into a Stone Pillar, cliff, or another unit triggers <b>\U0001F4A5 -2 HP WALL SLAM damage</b>!\n\u2022 Shove fragile enemy Tamers into lava or water to neutralize them instantly!\n\n<b><color=#34D399>5. Siphon Land & Cataclysm:</color></b>\n\u2022 \u26A1 <b>Siphon:</b> Your Titan drains active lava into Barren Earth to harvest <b>Elemental Cores</b>.\n\u2022 \U0001F30B <b>Magma Cataclysm:</b> Spend 3 Cores to trigger a screen-shattering volcanic blast wiping the field!"
