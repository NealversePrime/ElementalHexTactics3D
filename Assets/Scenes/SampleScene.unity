    m_RichText: 1
    m_HorizontalOverflow: 1
    m_VerticalOverflow: 1
    m_LineSpacing: 1
  m_Text: "<b><color=#38BDF8>1. Camera Controls:</color></b> <b>Q / E</b> Rotate 60\xB0 | <b>WASD</b> Pan | <b>Scroll</b> Zoom in/out\n<b><color=#38BDF8>2. Holy Orders:</color></b> <b>Left-Click</b> to Select Unit / Strike | <b>Right-Click</b> to Cancel\n\n<b><color=#FBBF24>3. Tactical Movement:</color></b>\n\u2022 Click your Paladin or Shielder to view reachable tiles (cyan highlights).\n\u2022 Click any highlighted hex to advance toward the demon lines.\n\n<b><color=#EF5350>4. Righteous Strike:</color></b>\n\u2022 When adjacent to an enemy (red highlights), click to unleash holy damage!\n\n<b><color=#34D399>5. Victory Objective:</color></b>\n\u2022 Slay the Demon Lord to purge the underworld and complete the sacred crusade!"
